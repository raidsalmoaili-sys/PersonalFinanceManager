<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام الإدارة المالية الشخصية</title>
    @await Html.PartialAsync("_ThemeScript")
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Cairo:wght@400;500;600;700;800&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color:var(--bg); color:var(--ink);" class="font-sans min-h-screen">
    <div style="display:grid; grid-template-columns:1.05fr .95fr; min-height:100vh;" class="max-lg:!flex max-lg:flex-col">
        <div style="background-color:var(--nav); color:#E2E8F0; padding:40px 44px 32px; display:flex; flex-direction:column; justify-content:space-between; min-height:320px;" class="max-lg:hidden">
            <div style="display:flex; align-items:center; gap:12px;">
                <div style="width:40px; height:40px; border-radius:11px; background-color:var(--save); display:grid; place-items:center; font-weight:800; color:#04291E; font-size:17px;">م</div>
                <div style="font-weight:700; font-size:17px; letter-spacing:-.2px;">نظام الإدارة المالية الشخصية</div>
            </div>
            <div style="display:flex; flex-direction:column; gap:16px; max-width:420px;">
                <div style="font-family:'Cairo',sans-serif; font-weight:800; font-size:32px; line-height:1.3; color:#F8FAFC;">لوحة تحكم واحدة لكل أهدافك المالية</div>
                <div style="font-size:14px; line-height:1.8; color:#9FB0C6;">أنشئ أي عدد من الخطط — ادخار، سداد دين، أو استثمار — وتابع كل خطة بلوحة تحليلات وسجل تفصيلي خاص بها.</div>
                <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:6px;">
                    <div style="padding:9px 14px; border-radius:999px; background-color:rgba(16,185,129,.14); color:#6EE7B7; font-size:13px; font-weight:600;">خطط غير محدودة</div>
                    <div style="padding:9px 14px; border-radius:999px; background-color:rgba(99,102,241,.16); color:#A5B4FC; font-size:13px; font-weight:600;">تحليلات فورية</div>
                </div>
            </div>
            <div style="font-size:12.5px; color:#64748B;">© @DateTime.Now.Year جميع الحقوق محفوظة</div>
        </div>

        <div style="display:grid; place-items:center; padding:24px 20px;">
            <div style="width:100%; max-width:380px; display:flex; flex-direction:column; gap:16px;">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
