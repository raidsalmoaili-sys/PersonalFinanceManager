@using System.Security.Claims
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام الإدارة المالية الشخصية</title>
    @await Html.PartialAsync("_ThemeScript")
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Cairo:wght@400;500;600;700;800&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color:var(--bg); color:var(--ink);" class="font-sans min-h-screen">
    <div style="display:flex; min-height:100vh; align-items:stretch;">
        <aside id="sidebar" style="width:238px; flex:0 0 auto; background-color:var(--nav); color:var(--navink); padding:18px 12px; display:flex; flex-direction:column; gap:22px; transition:width .22s ease;">
            <div style="display:flex; align-items:center; gap:11px; padding:0 6px;">
                <div style="width:34px; height:34px; flex:0 0 auto; border-radius:10px; background-color:var(--save); display:grid; place-items:center; font-weight:800; color:#04291E; font-size:15px;">م</div>
                <div class="sidebar-label" style="font-size:13.5px; font-weight:700; color:#E2E8F0; white-space:nowrap; overflow:hidden;">الإدارة المالية</div>
            </div>

            <div style="display:flex; flex-direction:column; gap:6px;">
                <a href="@Url.Action("Index", "Plans")" style="display:flex; align-items:center; gap:12px; padding:11px 10px; border-radius:10px; text-align:right; font-size:14px; font-weight:600; text-decoration:none; background-color:@(ViewContext.RouteData.Values["controller"]?.ToString() == "Plans" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "var(--navactive)" : "transparent"); color:@(ViewContext.RouteData.Values["controller"]?.ToString() == "Plans" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "#F1F5F9" : "var(--navink)");">
                    <span style="width:18px; flex:0 0 auto; display:grid; place-items:center; font-size:15px;">▤</span>
                    <span class="sidebar-label" style="white-space:nowrap;">النظرة العامة</span>
                </a>

                <div class="sidebar-label" style="padding:12px 10px 4px; font-size:11px; font-weight:700; color:#475569; letter-spacing:.4px;">الخطط المالية</div>

                @if (ViewData["SidebarPlans"] is List<PersonalFinanceManager1.ViewModels.PlanCardViewModel> sidebarPlans)
                {
                    var currentPlanId = ViewData["CurrentPlanId"] as Guid?;
                    foreach (var p in sidebarPlans)
                    {
                        var isActive = currentPlanId == p.Id;
                        <a href="@Url.Action("Details", "Plans", new { id = p.Id })" style="display:flex; align-items:center; gap:12px; padding:11px 10px; border-radius:10px; text-align:right; font-size:13.5px; font-weight:600; text-decoration:none; opacity:@(p.IsPaused ? "0.5" : "1"); background-color:@(isActive ? "var(--navactive)" : "transparent"); color:@(isActive ? "#F1F5F9" : "var(--navink)");">
                            <span style="width:18px; flex:0 0 auto; display:grid; place-items:center;"><span style="width:9px; height:9px; border-radius:3px; background-color:@p.ColorHex; display:block;"></span></span>
                            <span class="sidebar-label" style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@p.Name@(p.IsPaused ? " (موقوفة)" : "")</span>
                        </a>
                    }
                }

                <button type="button" id="openCreatePlanBtnSidebar" style="display:flex; align-items:center; gap:12px; padding:11px 10px; border:1px dashed #334155; border-radius:10px; cursor:pointer; text-align:right; font-size:13.5px; font-weight:700; background:transparent; color:#94A3B8; margin-top:4px;">
                    <span style="width:18px; flex:0 0 auto; display:grid; place-items:center; font-size:15px;">＋</span>
                    <span class="sidebar-label" style="white-space:nowrap;">خطة جديدة</span>
                </button>
            </div>

            <div style="margin-top:auto; display:flex; flex-direction:column; gap:6px;">
                <button type="button" id="sidebarToggle" style="display:flex; align-items:center; gap:12px; padding:11px 10px; border:0; border-radius:10px; cursor:pointer; text-align:right; font-size:13.5px; font-weight:600; background:transparent; color:var(--navink);">
                    <span id="sidebarToggleIcon" style="width:18px; flex:0 0 auto; display:grid; place-items:center; font-size:14px;">«</span>
                    <span class="sidebar-label" style="white-space:nowrap;">تصغير القائمة</span>
                </button>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" style="width:100%; display:flex; align-items:center; gap:12px; padding:11px 10px; border:0; border-radius:10px; cursor:pointer; text-align:right; font-size:13.5px; font-weight:600; background:transparent; color:#FCA5A5;">
                        <span style="width:18px; flex:0 0 auto; display:grid; place-items:center; font-size:14px;">⏻</span>
                        <span class="sidebar-label" style="white-space:nowrap;">تسجيل الخروج</span>
                    </button>
                </form>
            </div>
        </aside>

        <div style="flex:1 1 auto; min-width:0; display:flex; flex-direction:column;">
            <div style="display:flex; align-items:center; gap:16px; flex-wrap:wrap; padding:16px 24px; background-color:var(--panel); border-bottom:1px solid var(--line);">
                <div style="min-width:0;">
                    <div style="font-size:12px; color:var(--muted); font-weight:600;">@ViewData["Crumb"]</div>
                    <div style="font-family:'Cairo',sans-serif; font-size:20px; font-weight:800; margin-top:3px;">@ViewData["Title"]</div>
                </div>
                @if (ViewData["CurrentPlanId"] is Guid currentPlanIdForToggle)
                {
                    var isPlanPaused = ViewData["CurrentPlanPaused"] is true;
                    <form asp-controller="Plans" asp-action="TogglePause" asp-route-id="@currentPlanIdForToggle" method="post" style="display:flex; align-items:center; gap:9px;">
                        @Html.AntiForgeryToken()
                        <span style="font-size:12px; font-weight:700; color:@(isPlanPaused ? "var(--muted)" : "var(--save)");">@(isPlanPaused ? "موقوفة مؤقتًا" : "نشطة")</span>
                        <button type="submit" aria-label="@(isPlanPaused ? "تفعيل الخطة" : "إيقاف الخطة مؤقتًا")" title="@(isPlanPaused ? "تفعيل الخطة" : "إيقاف الخطة مؤقتًا")" style="position:relative; width:42px; height:23px; flex:0 0 auto; border-radius:999px; border:0; cursor:pointer; background-color:@(isPlanPaused ? "var(--chip)" : "var(--save)");">
                            <span style="position:absolute; top:2px; @(isPlanPaused ? "left:2px;" : "right:2px;") width:19px; height:19px; border-radius:50%; background-color:#fff; box-shadow:0 1px 3px rgba(0,0,0,.3); transition:all .15s ease;"></span>
                        </button>
                    </form>
                }
                <div style="margin-right:auto; display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                    <select id="fontSelect" style="padding:9px 12px; border:1px solid var(--line); border-radius:10px; background-color:var(--panel); color:var(--ink2); font-size:12.5px; font-weight:600; cursor:pointer; outline:none;" aria-label="اختيار الخط">
                        <option value="plex">خط IBM Plex Sans Arabic</option>
                        <option value="cairo">خط Cairo</option>
                        <option value="tajawal">خط Tajawal</option>
                    </select>
                    <button type="button" id="themeToggle" style="padding:9px 13px; border:1px solid var(--line); border-radius:10px; background-color:var(--panel); color:var(--ink2); font-size:12.5px; font-weight:600; cursor:pointer;">
                        <span id="themeToggleLabel">الوضع الليلي</span>
                    </button>
                    <div style="display:flex; align-items:center; gap:9px; padding:6px 12px 6px 6px; border:1px solid var(--line); border-radius:999px;">
                        <div style="font-size:12.5px; font-weight:600; color:var(--ink2);">@(User.FindFirstValue("FullName") is { Length: > 0 } fn ? fn : User.Identity?.Name)</div>
                        <div style="width:28px; height:28px; border-radius:50%; background-color:var(--debt); color:#fff; display:grid; place-items:center; font-size:12px; font-weight:700;">
                            @((User.FindFirstValue("FullName") is { Length: > 0 } fn2 ? fn2 : User.Identity?.Name ?? "م")[..1].ToUpper())
                        </div>
                    </div>
                </div>
            </div>

            <main style="padding:22px 24px 40px; flex:1;">
                @RenderBody()
            </main>
        </div>
    </div>

    <partial name="_CreatePlanModal" model="@(ViewData["NewPlanModel"] as CreatePlanViewModel ?? new CreatePlanViewModel())" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
