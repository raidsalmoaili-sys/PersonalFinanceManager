@model PersonalFinanceManager1.ViewModels.AuthPageViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "تسجيل الدخول";
    var activeTab = Model.ActiveTab == "register" ? "register" : "login";
}

<div class="card p-6">
    <div class="lg:hidden flex items-center gap-3 mb-4">
        <div class="w-8 h-8 rounded-chip flex items-center justify-center font-bold text-white" style="background-color:var(--save);">م</div>
        <span class="text-base font-semibold">الإدارة المالية الشخصية</span>
    </div>

    <div class="flex chip p-1 mb-4" role="tablist">
        <button type="button" data-auth-tab="login" role="tab"
                class="flex-1 py-2 rounded-chip text-sm font-medium transition-colors auth-tab-btn @(activeTab == "login" ? "auth-tab-active" : "")">
            تسجيل الدخول
        </button>
        <button type="button" data-auth-tab="register" role="tab"
                class="flex-1 py-2 rounded-chip text-sm font-medium transition-colors auth-tab-btn @(activeTab == "register" ? "auth-tab-active" : "")">
            إنشاء حساب
        </button>
    </div>

    <div id="authPanelLogin" class="@(activeTab == "login" ? "" : "hidden")">
        <h1 style="font-family:'Cairo',sans-serif; font-weight:800; font-size:22px; line-height:1.3;">مرحباً بعودتك</h1>
        <p class="text-sm mb-4" style="color:var(--muted); margin-top:4px;">ادخل بياناتك للوصول إلى لوحة التحكم المالية</p>

        <div class="mb-4 text-sm" style="padding:12px; border-radius:12px; border:1px solid color-mix(in srgb, var(--save) 35%, transparent); background:color-mix(in srgb, var(--save) 8%, transparent);">
            <div class="flex items-center gap-3" style="margin-bottom:10px;">
                <div class="flex items-center justify-center font-bold" style="width:28px; height:28px; flex-shrink:0; border-radius:8px; background:var(--save); color:#fff;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                </div>
                <div>
                    <div class="font-bold" style="color:var(--save);">نسخة تجريبية</div>
                    <div class="text-xs" style="color:var(--muted); margin-top:2px;">جرّب النظام ببيانات جاهزة</div>
                </div>
            </div>

            <div style="border-radius:9px; background:var(--chip); border:1px solid var(--line); overflow:hidden;">
                <div class="flex items-center justify-between" style="padding:6px 12px; border-bottom:1px solid var(--line);">
                    <span class="text-xs" style="color:var(--muted);">البريد الإلكتروني</span>
                    <span dir="ltr" style="color:var(--ink2); font-family:ui-monospace,Consolas,monospace; font-size:13px;">@PersonalFinanceManager1.Data.DemoAccountSeeder.DemoEmail</span>
                </div>
                <div class="flex items-center justify-between" style="padding:6px 12px;">
                    <span class="text-xs" style="color:var(--muted);">كلمة المرور</span>
                    <span dir="ltr" style="color:var(--ink2); font-family:ui-monospace,Consolas,monospace; font-size:13px;">@PersonalFinanceManager1.Data.DemoAccountSeeder.DemoPassword</span>
                </div>
            </div>

            <button type="button" id="fillDemo" class="w-full text-sm font-bold" style="margin-top:10px; padding:8px; border-radius:10px; background:var(--save); color:#fff; border:none; cursor:pointer;">تعبئة بيانات الحساب التجريبي</button>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Context.Request.Query["returnUrl"]" />
            <div asp-validation-summary="ModelOnly" class="text-sm mb-4" style="color:var(--danger);"></div>

            <div class="mb-3">
                <label asp-for="Login.Email" class="block text-sm font-medium mb-1"></label>
                <input asp-for="Login.Email" dir="ltr" class="input-field w-full px-3 py-2 text-sm text-right" placeholder="name@example.com" />
                <span asp-validation-for="Login.Email" class="text-xs" style="color:var(--danger);"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Login.Password" class="block text-sm font-medium mb-1"></label>
                <input asp-for="Login.Password" dir="ltr" class="input-field w-full px-3 py-2 text-sm text-right" placeholder="••••••••" />
                <span asp-validation-for="Login.Password" class="text-xs" style="color:var(--danger);"></span>
            </div>

            <div class="flex items-center justify-between mb-4">
                <label class="flex items-center gap-2 text-sm" style="color:var(--ink2);">
                    <input asp-for="Login.RememberMe" class="rounded" />
                    <span>تذكرني</span>
                </label>
            </div>

            <button type="submit" class="btn-primary w-full py-2.5 text-sm font-bold">دخول إلى اللوحة</button>
        </form>
    </div>

    <div id="authPanelRegister" class="@(activeTab == "register" ? "" : "hidden")">
        <h1 style="font-family:'Cairo',sans-serif; font-weight:800; font-size:22px; line-height:1.3;">أنشئ حسابك</h1>
        <p class="text-sm mb-4" style="color:var(--muted); margin-top:4px;">دقيقة واحدة لبدء تتبع أهدافك المالية</p>

        <form asp-controller="Account" asp-action="Register" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Context.Request.Query["returnUrl"]" />
            <div asp-validation-summary="ModelOnly" class="text-sm mb-4" style="color:var(--danger);"></div>

            <div class="mb-3">
                <label asp-for="Register.FullName" class="block text-sm font-medium mb-1"></label>
                <input asp-for="Register.FullName" class="input-field w-full px-3 py-2 text-sm" placeholder="محمد العبدالله" />
                <span asp-validation-for="Register.FullName" class="text-xs" style="color:var(--danger);"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Register.Email" class="block text-sm font-medium mb-1"></label>
                <input asp-for="Register.Email" dir="ltr" class="input-field w-full px-3 py-2 text-sm text-right" placeholder="name@example.com" />
                <span asp-validation-for="Register.Email" class="text-xs" style="color:var(--danger);"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Register.Password" class="block text-sm font-medium mb-1"></label>
                <input asp-for="Register.Password" dir="ltr" class="input-field w-full px-3 py-2 text-sm text-right" placeholder="••••••••" />
                <p class="text-xs mt-1" style="color:var(--muted);">6 أحرف على الأقل</p>
                <span asp-validation-for="Register.Password" class="text-xs" style="color:var(--danger);"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Register.ConfirmPassword" class="block text-sm font-medium mb-1"></label>
                <input asp-for="Register.ConfirmPassword" dir="ltr" class="input-field w-full px-3 py-2 text-sm text-right" placeholder="••••••••" />
                <span asp-validation-for="Register.ConfirmPassword" class="text-xs" style="color:var(--danger);"></span>
            </div>

            <button type="submit" class="btn-primary w-full py-2.5 text-sm font-bold">إنشاء الحساب والدخول</button>
        </form>
    </div>
</div>

<script>
    document.getElementById('fillDemo')?.addEventListener('click', function () {
        document.getElementById('Login_Email').value = '@PersonalFinanceManager1.Data.DemoAccountSeeder.DemoEmail';
        document.getElementById('Login_Password').value = '@PersonalFinanceManager1.Data.DemoAccountSeeder.DemoPassword';
    });
    window.pfmAuthActiveTab = @Html.Raw(Json.Serialize(activeTab));
</script>
